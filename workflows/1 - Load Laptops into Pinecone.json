    {
      "parameters": {
        "jsCode": "// 1) Turn each laptop row into a Pinecone record\nconst records = $input.all().map(item => {\n  const r = item.json;\n  const fullName = `${r.Company} ${r.Product}`;\n  return {\n    _id: String(r.Laptop_ID),\n    // Pinecone converts this \"text\" field into a vector for searching\n    text: `${fullName}. ${r.Type_Name} laptop, launched in ${r.Launch_Year}. ` +\n          `Price: $${Number(r.Price_USD).toFixed(2)}. Screen: ${r.Inches} inch ${r.Screen_Resolution}. ` +\n          `CPU: ${r.CPU}. RAM: ${r.RAM_GB}GB. Storage: ${r.Memory}. GPU: ${r.GPU}. ` +\n          `OS: ${r.Op_Sys}. Weight: ${r.Weight_kg} kg.`,\n    // Extra fields are saved as metadata (used for filters and the reply email)\n    Full_Name: fullName,\n    Company: r.Company,\n    Product: r.Product,\n    Type_Name: r.Type_Name,\n    Inches: Number(r.Inches),\n    Screen_Resolution: r.Screen_Resolution,\n    CPU: r.CPU,\n    RAM_GB: Number(r.RAM_GB),\n    Memory: r.Memory,\n    GPU: r.GPU,\n    Op_Sys: r.Op_Sys,\n    Weight_kg: Number(r.Weight_kg),\n    Price_USD: Number(r.Price_USD),\n    Launch_Year: Number(r.Launch_Year),\n  };\n});\n\n// 2) Pinecone accepts max 96 records per request, so group them into batches\nconst batches = [];\nfor (let i = 0; i < records.length; i += 96) {\n  const batch = records.slice(i, i + 96);\n  batches.push({ json: {\n    batch_no: batches.length + 1,\n    record_count: batch.length,\n    ndjson: batch.map(rec => JSON.stringify(rec)).join('\\n'), // one record per line\n  }});\n}\nreturn batches;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        0
      ],
