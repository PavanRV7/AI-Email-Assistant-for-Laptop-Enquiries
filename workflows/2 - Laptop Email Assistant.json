      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1168,
        -80
      ],
      "id": "6a1ed744-df64-4ca9-b7dd-12163b2922c5",
      "name": "Search Pinecone",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "jKiYw9Mb8bEn4MMu",
          "name": "Pinecone API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Keep only laptops that match the request, and prepare ready-made lines for the reply\nconst norm = s => String(s ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst ai = $('Understand Email').first().json.output;\nconst wants = ai.requested_info || [];\nconst requests = $('Build Search Requests').all();\nconst money = n => '$' + Number(n).toFixed(2);\n\n// One finished line per laptop (facts come straight from the database)\nconst toLine = (l, withName) => {\n  const parts = [];\n  if (withName) parts.push(l.Full_Name);\n  parts.push(l.CPU, `${l.RAM_GB}GB RAM`, l.Memory, l.GPU);\n  if (wants.includes('specifications')) {\n    parts.push(`${l.Inches} inch ${l.Screen_Resolution}`, l.Op_Sys, `${l.Weight_kg} kg`);\n  } else {\n    // Short screen info, so versions that differ only by screen don't look identical\n    const res = (l.Screen_Resolution.match(/\\d+x\\d+/) || [''])[0];\n    parts.push(`${l.Inches}\" ${res}${/touch/i.test(l.Screen_Resolution) ? ' touchscreen' : ''}`.trim());\n  }\n  if (withName || wants.includes('launch_year')) parts.push(`launched ${l.Launch_Year}`);\n  parts.push(money(l.Price_USD));\n  return parts.join(' | ');\n};\n\n// If there are many versions, pick up to 6 spread from cheapest to most expensive\nconst spread = (list, max) => {\n  const sorted = [...list].sort((a, b) => a.Price_USD - b.Price_USD);\n  if (sorted.length <= max) return sorted;\n  const idx = [...new Set(Array.from({ length: max }, (_, i) => Math.round(i * (sorted.length - 1) / (max - 1))))];\n  return idx.map(i => sorted[i]);\n};\n\nconst results = $input.all().map((item, i) => {\n  const req = requests[i].json;\n  const hits = (item.json.result?.hits ?? []).map(h => h.fields);\n\n  if (req.kind === 'general' || req.kind === 'general_backup') {\n        // Backup: take the best laptop from each brand in turn, so alternatives show a mix of brands\n    let top = hits.slice(0, 5);\n    if (req.kind === 'general_backup') {\n      const byBrand = {};\n      hits.forEach(h => (byBrand[h.Company] ??= []).push(h));\n      const lists = Object.values(byBrand);\n      top = [];\n      for (let i = 0; top.length < 5 && lists.some(l => l[i]); i++) {\n        lists.forEach(l => { if (l[i] && top.length < 5) top.push(l[i]); });\n      }\n    }\n    return { asked: req.asked, kind: req.kind, found: top.length > 0, alternatives: false, lines: top.map(l => toLine(l, true)), names: top.map(l => l.Full_Name) };\n  }\n\n\n  const m = norm(req.model);\n  let matches = hits.filter(h => norm(h.Product) === m || norm(h.Full_Name) === m);\n  if (!matches.length && m.length >= 4) {\n    matches = hits.filter(h => norm(h.Product).length >= 4 &&\n      (norm(h.Product).includes(m) || m.includes(norm(h.Product))));\n  }\n\n  if (!matches.length) {\n        // 3 different models as alternatives (not 3 versions of the same one)\n    const alt = [...new Map(hits.map(h => [h.Full_Name, h])).values()].slice(0, 3);\n    return { asked: req.asked, kind: 'model', found: false, lines: alt.map(l => toLine(l, true)), names: [] };\n  }\n\n  const prices = matches.map(l => l.Price_USD);\n  return {\n    asked: req.asked,\n    kind: 'model',\n    found: true,\n    total_versions: matches.length,\n    price_range: `${money(Math.min(...prices))} to ${money(Math.max(...prices))}`,\n    lines: spread(matches, 6).map(l => toLine(l, false)),\n    names: matches.map(l => l.Full_Name),\n  };\n});\n\n// Use the backup (other brands) only when the exact search found nothing\nconst general = results.find(r => r.kind === 'general');\nconst backup = results.find(r => r.kind === 'general_backup');\nif (general && !general.found && backup?.found) {\n  general.lines = backup.lines;\n  general.alternatives = true;\n}\nresults.splice(0, results.length, ...results.filter(r => r.kind !== 'general_backup'));\nconst matched = [...new Set(results.flatMap(r => r.names))];\nreturn [{ json: { results, any_found: results.some(r => r.found), matched_names: matched.join(', ') || 'None' } }];"
      },
