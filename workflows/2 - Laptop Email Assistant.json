    {
      "parameters": {
        "text": "=Subject: {{ $json.subject }}\nEmail:\n{{ $json.body }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\"laptop_query\", \"general_question\", \"not_related\"],\n      \"description\": \"laptop_query = asks about specific laptop(s) by name/model. general_question = asks for laptops by brand, budget, type, specs or newest models without naming a model. not_related = anything else (spam, newsletters, unrelated topics).\"\n    },\n    \"laptops\": {\n      \"type\": \"array\",\n      \"description\": \"Every laptop model the customer mentions. Empty array if none.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"company\": { \"type\": \"string\", \"description\": \"Brand, e.g. Lenovo, HP, Dell, Apple, Asus, Acer, MSI, Toshiba\" },\n          \"model\": { \"type\": \"string\", \"description\": \"Model name exactly as written, without the brand, e.g. Legion Y520-15IKBN\" }\n        },\n        \"required\": [\"model\"]\n      }\n    },\n    \"requested_info\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\", \"enum\": [\"price\", \"specifications\", \"launch_year\", \"comparison\", \"recommendation\", \"other\"] }\n    },\n    \"filters\": {\n      \"type\": \"object\",\n      \"description\": \"Only fill fields the customer actually mentions.\",\n      \"properties\": {\n        \"company\": { \"type\": \"string\" },\n        \"type_name\": { \"type\": \"string\", \"enum\": [\"Notebook\", \"Gaming\", \"Ultrabook\", \"2 in 1 Convertible\", \"Workstation\", \"Netbook\"] },\n        \"min_price_usd\": { \"type\": \"number\" },\n        \"max_price_usd\": { \"type\": \"number\" },\n        \"min_ram_gb\": { \"type\": \"number\" },\n        \"launch_year\": { \"type\": \"number\" }\n      }\n    },\n    \"search_text\": {\n      \"type\": \"string\",\n      \"description\": \"A short search phrase for the laptop database, e.g. 'Lenovo Legion Y520-15IKBN' or 'HP gaming laptop 16GB RAM'\"\n    }\n  },\n  \"required\": [\"category\", \"laptops\", \"requested_info\", \"search_text\"]\n}",
        "options": {
          "systemPromptTemplate": "=You read customer emails sent to a laptop store and extract structured data.\nRules:\n- Never invent laptops or details that are not in the email.\n- Keep model names exactly as the customer wrote them.\n- If the customer asks for \"new\", \"latest\" or \"this year's\" laptops, set filters.launch_year to {{ $now.year }}.\n- Prices are in US dollars.\n- If the email is not about laptops, use category \"not_related\" with an empty laptops array."
        }
