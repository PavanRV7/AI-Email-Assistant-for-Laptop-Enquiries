    {
      "parameters": {
        "jsCode": "// Turn Gemini's understanding into Pinecone search requests\nconst ai = $('Understand Email').first().json.output;\n\n// Brand names exactly as stored in Pinecone (fixes \"hp\", \"Lenovo Inc\" etc.)\nconst BRANDS = ['Acer','Apple','Asus','Chuwi','Dell','Fujitsu','Google','HP','Huawei','LG',\n                'Lenovo','MSI','Mediacom','Microsoft','Razer','Samsung','Toshiba','Vero','Xiaomi'];\nconst toBrand = name => {\n  if (!name) return null;\n  const n = String(name).toLowerCase().replace(/[^a-z]/g, '');\n  return BRANDS.find(b => n === b.toLowerCase() || n.startsWith(b.toLowerCase())) || null;\n};\n\nconst searches = [];\n\nif (ai.category === 'laptop_query' && ai.laptops?.length) {\n  // One search per laptop the customer named\n  for (const laptop of ai.laptops) {\n    const company = toBrand(laptop.company) || toBrand(laptop.model.split(' ')[0]);\n    const query = { inputs: { text: `${company ?? ''} ${laptop.model}`.trim() }, top_k: 50 };\n    if (company) query.filter = { Company: { $eq: company } };\n    searches.push({ kind: 'model', asked: `${company ?? ''} ${laptop.model}`.trim(), model: laptop.model, body: { query } });\n  }\n} else {\n  // General question: one search using Gemini's filters\n  const f = ai.filters || {};\n  const filter = {};\n  if (toBrand(f.company)) filter.Company = { $eq: toBrand(f.company) };\n  if (f.type_name) filter.Type_Name = { $eq: f.type_name };\n  if (f.min_price_usd || f.max_price_usd) {\n    filter.Price_USD = {};\n    if (f.min_price_usd) filter.Price_USD.$gte = f.min_price_usd;\n    if (f.max_price_usd) filter.Price_USD.$lte = f.max_price_usd;\n  }\n  if (f.min_ram_gb) filter.RAM_GB = { $gte: f.min_ram_gb };\n  if (f.launch_year) filter.Launch_Year = { $eq: f.launch_year };\n\n  const query = { inputs: { text: ai.search_text || 'laptop' }, top_k: 10 };\n  if (Object.keys(filter).length) query.filter = filter;\n  searches.push({ kind: 'general', asked: ai.search_text, body: { query } });\n    // Backup search without the brand filter (used only if the exact search finds nothing)\n  if (filter.Company) {\n    const { Company, ...relaxed } = filter;\n    const backup = { inputs: query.inputs, top_k: 30 };\n    if (Object.keys(relaxed).length) backup.filter = relaxed;\n    searches.push({ kind: 'general_backup', asked: ai.search_text, body: { query: backup } });\n  }\n}\n\nreturn searches.map(s => ({ json: s }));"
      },
